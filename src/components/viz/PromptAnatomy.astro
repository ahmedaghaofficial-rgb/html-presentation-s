---
/** PromptAnatomy — البرومبت بيتركّب قدامك من ٣ طبقات، وكل طبقة بتنوّر لما تركب. */
---
<div class="pa-wrap"><canvas id="paViz"></canvas></div>
<style>
  .pa-wrap { position: relative; width: 100%; height: 310px; }
  .pa-wrap canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
<script>
  import { fit, loop, CL, card, arrow, txt, pill, at, ease, lerp, pulse } from '@lib/viz';

  const C = document.getElementById('paViz') as HTMLCanvasElement | null;
  if (C) {
    const s = fit(C);
    const CYCLE = 620;

    const LAYERS = [
      { t: 'السياق',     d: 'إنت مين · بتشتغل على إيه · لمين', col: CL.indigo },
      { t: 'المهمة',     d: 'عايزه يعمل إيه بالظبط — فعل واحد', col: CL.violet },
      { t: 'شكل الخروج', d: 'يرجّعلك إيه: جدول · نقط · كود',   col: CL.pink },
    ];

    loop((frame) => {
      const { ctx, W, H } = s;
      ctx.clearRect(0, 0, W, H);
      const f = frame % CYCLE;

      const bw = Math.min(330, W * 0.5);
      const bh = 56, gap = 12;
      const xL = W * 0.31;
      const y0 = 42;

      // ── الطبقات بتترص من فوق لتحت ──
      LAYERS.forEach((L, i) => {
        const p = at(f, 20 + i * 70, 110 + i * 70);
        if (p <= 0) return;
        const e = ease(p);
        const y = y0 + i * (bh + gap);
        // بتزحف من الشمال وهي بتظهر
        const x = lerp(xL - 70, xL, e);
        ctx.save(); ctx.globalAlpha = e;
        card(ctx, x - bw / 2, y, bw, bh, { stroke: L.col, glow: 0.7 });
        txt(ctx, L.t, x + bw / 2 - 18, y + 21, { size: 14.5, col: L.col, weight: 900, align: 'right' });
        txt(ctx, L.d, x + bw / 2 - 18, y + 41, { size: 11.5, col: CL.dim, weight: 600, align: 'right' });
        // رقم الطبقة
        txt(ctx, String(i + 1), x - bw / 2 + 22, y + bh / 2, { size: 20, col: L.col, weight: 900 });
        ctx.restore();
      });

      // ── السهم للنتيجة ──
      const stackH = LAYERS.length * bh + (LAYERS.length - 1) * gap;
      const midY = y0 + stackH / 2;
      const pArr = at(f, 250, 320);
      const xOut = W * 0.78;
      if (pArr > 0) {
        arrow(ctx, xL - bw / 2 - 14, midY, xOut + 52, midY, CL.cyan, { a: ease(pArr), lw: 2.4, head: 10 });
      }

      // ── النتيجة ──
      const pOut = at(f, 310, 400);
      if (pOut > 0) {
        const e = ease(pOut);
        const g = 0.55 + 0.45 * pulse(frame, 0.05);
        ctx.save(); ctx.globalAlpha = e;
        card(ctx, xOut - 52, midY - 52, 104, 104, { stroke: CL.green, glow: g });
        txt(ctx, 'رد', xOut, midY - 16, { size: 15, col: CL.green, weight: 900 });
        txt(ctx, 'تستخدمه', xOut, midY + 6, { size: 15, col: CL.green, weight: 900 });
        txt(ctx, 'زي ما هو', xOut, midY + 28, { size: 12, col: CL.dim, weight: 700 });
        ctx.restore();
      }

      // ── الملحوظة اللي بتقفل الفكرة ──
      const pNote = at(f, 400, 470);
      if (pNote > 0) {
        pill(ctx, 'ناقصة طبقة؟ الـAI بيخمّن مكانها', W / 2, H - 20,
             { col: CL.amber, size: 12.5, a: ease(pNote), glow: 0.5 });
      }
    });
  }
</script>
