---
/**
 * SaboraBlank — سبورة فيها الأسئلة الفعلية للتمرين، وسايبة مساحة للإجابة.
 * الأسئلة مرسومة بالماركر وتحت كل واحد سطر منقّط فاضي — والطالب (أو انت وانت
 * بتشرح) بيكتب الإجابة عليها بالسبورة الحيّة (زرار B).
 *
 * <SaboraBlank title="…" hint="…" lines={['السؤال ١','السؤال ٢']} />
 */
interface Props { title?: string; hint?: string; lines?: (string | [string, string])[] }
const { title = 'اكتب هنا', hint = 'دوس B وابدأ اكتب', lines = [] } = Astro.props;
---
<div class="sbb-wrap" data-title={title} data-hint={hint} data-lines={JSON.stringify(lines)}>
  <canvas id="saboraBlank"></canvas>
</div>
<style>
  .sbb-wrap { position: relative; width: 100%; height: 372px; }
  .sbb-wrap canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
<script>
  import { fit, loop, board, txt, CL, at } from '@lib/viz';

  const C = document.getElementById('saboraBlank') as HTMLCanvasElement | null;
  if (C) {
    const wrap = C.parentElement as HTMLElement;
    const TITLE = wrap.dataset.title || 'اكتب هنا';
    const HINT = wrap.dataset.hint || '';
    type Row = { q: string; ex: string };
    let LINES: Row[] = [];
    try {
      const raw = JSON.parse(wrap.dataset.lines || '[]') as (string | [string, string])[];
      LINES = raw.map((r) => (Array.isArray(r) ? { q: r[0], ex: r[1] || '' } : { q: r, ex: '' }));
    } catch { LINES = []; }
    const s = fit(C);
    const AR = ['١', '٢', '٣', '٤', '٥', '٦'];

    loop((frame) => {
      const { ctx, W, H } = s;
      ctx.clearRect(0, 0, W, H);
      const f = Math.min(frame, 400);   // الأسئلة بتتكتب مرة واحدة وتفضل
      const b = board(ctx, W, H, { title: TITLE, frame });

      // خط ماركر تحت العنوان
      ctx.save();
      ctx.font = '800 17px Lemonada, Cairo, sans-serif';
      const tw = ctx.measureText(TITLE).width;
      ctx.strokeStyle = 'rgba(236,72,153,0.55)'; ctx.lineWidth = 2; ctx.lineCap = 'round';
      ctx.shadowColor = CL.pink; ctx.shadowBlur = 6;
      ctx.beginPath();
      ctx.moveTo(b.x + b.w - 22, b.y + 44);
      ctx.lineTo(b.x + b.w - 22 - tw, b.y + 45.5);
      ctx.stroke(); ctx.restore();

      // ── الأسئلة + مساحة الإجابة ──
      const top = b.y + 76;
      const avail = b.h - 76 - 34;
      const step = LINES.length ? Math.min(74, avail / LINES.length) : 0;

      LINES.forEach((q, i) => {
        const p = at(f, 30 + i * 34, 30 + i * 34 + 40);
        if (p <= 0) return;
        const y = top + i * step;
        const rx = b.x + b.w - 24;

        // رقم السؤال
        ctx.save();
        ctx.globalAlpha = p;
        ctx.beginPath(); ctx.arc(rx - 11, y, 11, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(168,85,247,0.16)'; ctx.fill();
        ctx.strokeStyle = 'rgba(168,85,247,0.55)'; ctx.lineWidth = 1.2; ctx.stroke();
        ctx.restore();
        txt(ctx, AR[i] || String(i + 1), rx - 11, y + 1, { size: 11.5, weight: 900, col: CL.violet, a: p });

        // نص السؤال
        txt(ctx, q.q, rx - 30, y + 1, { size: 14, weight: 800, col: CL.chalk, align: 'right', a: p, font: 'marker' });

        // مثال باهت — بيوضّح شكل الإجابة المطلوبة
        if (q.ex) {
          const ep = at(f, 30 + i * 34 + 16, 30 + i * 34 + 54);
          if (ep > 0) {
            ctx.save();
            ctx.globalAlpha = ep;
            ctx.font = '700 11.5px Cairo, sans-serif';
            ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
            const maxW = b.w - 90;
            let t = 'مثال: ' + q.ex;
            if (ctx.measureText(t).width > maxW) {
              while (t.length > 8 && ctx.measureText(t + '…').width > maxW) t = t.slice(0, -1);
              t += '…';
            }
            ctx.fillStyle = 'rgba(200,190,255,0.42)';
            ctx.fillText(t, rx - 30, y + 22);
            ctx.restore();
          }
        }

        // سطر الإجابة الفاضي
        const lp = at(f, 30 + i * 34 + 22, 30 + i * 34 + 60);
        if (lp > 0) {
          ctx.save();
          ctx.globalAlpha = lp * 0.42;
          ctx.strokeStyle = 'rgba(200,190,255,0.85)'; ctx.lineWidth = 1.4;
          ctx.setLineDash([6, 7]); ctx.lineCap = 'round';
          const ly = y + (q.ex ? 44 : step * 0.46);
          const x2 = b.x + 28, x1 = rx - 4;
          ctx.beginPath();
          ctx.moveTo(x1, ly);
          ctx.lineTo(x1 - (x1 - x2) * lp, ly);
          ctx.stroke();
          ctx.restore();
        }
      });

      if (!LINES.length) {
        txt(ctx, 'سبورة فاضية — اكتب اللي انت عايزه', b.x + b.w / 2, b.y + b.h / 2, {
          size: 14, weight: 800, col: 'rgba(200,190,255,0.35)',
        });
      }

      if (HINT) {
        txt(ctx, HINT, b.x + 22, b.y + b.h - 16, {
          size: 11.5, weight: 700, align: 'left',
          col: 'rgba(200,190,255,0.9)',
          a: 0.3 + 0.2 * Math.sin(frame * 0.022),
        });
      }
    });
  }
</script>
