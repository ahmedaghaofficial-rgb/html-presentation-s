---
/**
 * فهرس الدروس — أداة إنتاج داخلية (مش جزء من الفيديو).
 * كل درس = صفحة واحدة = فيديو واحد.
 */
import '@styles/global.css';
import BrandLogo from '@components/BrandLogo.astro';
import { LESSONS } from '@data/lessons';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ديك تجريبي — فهرس الدروس | Syntax Academy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="brand-bar">
      <div class="brand-left">
        <BrandLogo size={34} />
        <div>
          <div class="brand-name">ديك تجريبي</div>
          <div class="brand-sub">اختبار سكِل البريزنتيشن · Syntax Academy</div>
        </div>
      </div>
    </div>

    <div style="max-width:1100px;width:100%;margin:0 auto;padding:8px 0 40px">
      <h1 style="font-size:24px;font-weight:900;color:#f0eeff;margin:18px 0 6px">الدروس</h1>
      <p style="color:#8a8aa3;font-size:14px;margin:0 0 22px">كل درس صفحة واحدة = فيديو واحد. اضغط على الدرس عشان تفتح الديك.</p>

      <div style="display:flex;flex-direction:column;gap:10px">
        {LESSONS.map((l) => (
          l.href
            ? <a href={l.href} style="display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:14px;background:rgba(18,18,28,.82);border:1px solid rgba(255,255,255,.06);text-decoration:none;transition:all .2s">
                <span style="width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:10px;background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;font-weight:900;font-size:16px">{l.n}</span>
                <span style="flex:1;color:#f0eeff;font-weight:700;font-size:15px">{l.t}</span>
                <span style="color:#5c5c72;font-size:12px;font-weight:700">{l.m}</span>
              </a>
            : <div style="display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:14px;background:rgba(18,18,28,.4);border:1px dashed rgba(255,255,255,.07);opacity:.5">
                <span style="width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:10px;background:rgba(255,255,255,.05);color:#5c5c72;font-weight:900;font-size:16px">{l.n}</span>
                <span style="flex:1;color:#8a8aa3;font-weight:700;font-size:15px">{l.t}</span>
                <span style="color:#4b4b62;font-size:12px;font-weight:700">لسه</span>
              </div>
        ))}
      </div>
    </div>
  </body>
</html>
