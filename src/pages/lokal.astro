<script>
  const sales=document.getElementById('lokSales') as HTMLInputElement|null;
  const rate=document.getElementById('lokRate') as HTMLInputElement|null;
  if(sales && rate){
    const number=(n:number)=>new Intl.NumberFormat('ar-EG',{maximumFractionDigits:0}).format(n);
    const put=(id:string,value:string)=>{const e=document.getElementById(id);if(e)e.textContent=value;};
    const update=()=>{
      const v=Number(sales.value),p=Number(rate.value);
      put('lokSalesValue',number(v)+' ج');
      put('lokRateValue',number(p)+'٪');
      put('lokIncome',number(v*p/100)+' ج');
    };
    for(const input of [sales,rate]){
      input.addEventListener('input',update);
      // Syntax Deck's global arrow-key navigation must not hijack interactive sliders.
      input.addEventListener('keydown',e=>e.stopPropagation());
    }
    update();
  }
</script>
